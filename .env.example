# ---- Frontend (exposed in the browser bundle — never put secrets here) ----
# Public contact address shown in the footer. Leave empty to hide the link.
VITE_CONTACT_EMAIL=

# ---- Image hosting (Netlify Function, read on the server only) ----
# Set to "false" to turn image-to-QR hosting off entirely.
IMAGE_UPLOAD_ENABLED=true
# Max upload size in MB (1–4). Netlify Functions accept request bodies up to ~6 MB.
IMAGE_MAX_MB=4
